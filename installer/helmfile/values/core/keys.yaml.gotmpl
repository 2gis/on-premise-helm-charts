{{- $protocol := ternary "https" "http" .Values.ingressTls }}
api:
  logLevel: warning   # Can be: `trace`, `debug`, `info`, `warning`, `error`, `fatal`.
  oidc:
    enabled: true
    enableSinglePartnerMode: true
    enableExternalProvider: true
    url: {{ $protocol }}://{{ .Values.platformIdIngress }}/realms/Platform
    retryCount: 3
    timeout: 3s
    defaultPartner:
      id: 1
      name: 'Default Partner'
      role: admin
  resources:
    limits:
      cpu: 100m
      memory: 128Mi
    requests:
      cpu: 50m
      memory: 64Mi
  ingress:
    enabled: true
    className: {{ .Values.ingressClassName }}
    hosts:
    - host: {{ .Values.keysApiIngress }}
      paths:
      - path: /
        pathType: Prefix
    {{- if .Values.ingressTls }}
    tls:
    - hosts:
      - {{ .Values.keysApiIngress }}
      secretName: {{ .Values.tlsSecret }}
    {{- end }}

migrate:
  logLevel: warning   # Can be: `trace`, `debug`, `info`, `warning`, `error`, `fatal`.

tasker:
  logLevel: warning   # Can be: `trace`, `debug`, `info`, `warning`, `error`, `fatal`.

dispatcher:
  logLevel: warning   # Can be: `trace`, `debug`, `info`, `warning`, `error`, `fatal`.

cleaner:
  logLevel: warning   # Can be: `trace`, `debug`, `info`, `warning`, `error`, `fatal`.

kafka:
  stats:
    topic: 'stat.{{ .Environment.Name }}.type.401'
    groupId: '{{ .Environment.Name }}-keys-counter'
    clientId: '{{ .Environment.Name }}-keys-counter'

bootstrap:
  enabled: true

admin:
  enabled: false
