# Alertamanger settings
replicaCount: 2

resources:
  limits:
    cpu: 100m
    memory: 128Mi
  requests:
    cpu: 100m
    memory: 32Mi

config:
  enabled: true
  global:
    resolve_timeout: 15m
  route:
    group_by: ["alertname", "job"]
    group_wait: 10s
    group_interval: 5m
    repeat_interval: 24h

# configmap-reload side-container settings
configmapReload:
  enabled: true

  resources:
    limits:
      cpu: 100m
      memory: 128Mi
    requests:
      cpu: 100m
      memory: 32Mi
