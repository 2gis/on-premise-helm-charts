navigroup: {{ .Environment.Name }}

resources:
  limits:
    cpu: 250m
    memory: 256Mi
  requests:
    cpu: 100m
    memory: 128Mi

ingress:
  enabled: true
  className: {{ .Values.ingressClassName }}
  annotations:
  {{- if eq .Values.ingressController "nginx" }}
    {{- $annotations := pick .Values.ingressAnnotations.nginx "cors" -}}
    {{- $result := dict -}}
    {{- range $_, $value := $annotations }}
      {{- $result = merge $result $value -}}
    {{- end }}
    {{- $result | toYaml | nindent 4 }}
  {{- else if eq .Values.ingressController "traefik" }}
    {{- $annotations := pick .Values.ingressAnnotations.traefik "cors" -}}
    {{- $middlewares := join "," (sortAlpha (values $annotations)) -}}
    {{- dict "traefik.ingress.kubernetes.io/router.middlewares" $middlewares | toYaml | nindent 4 }}
  {{- else }}
    {}
  {{- end }}
  hosts:
    - host: {{ .Values.naviFrontIngress }}
      paths:
        - path: /
          pathType: Prefix
  {{- if .Values.ingressTls }}
  tls:
    - hosts:
        - {{ .Values.naviFrontIngress }}
      secretName: {{ .Values.tlsSecret }}
  {{- end }}
