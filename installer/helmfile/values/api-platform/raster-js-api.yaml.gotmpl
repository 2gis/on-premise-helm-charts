{{- $protocol := ternary "https" "http" .Values.ingressTls }}

api:
  publicHost: '{{ .Values.rasterJsApiIngress }}'
  protocol: '{{ $protocol }}'
  tileServerUrl: '{{ $protocol }}://{{ .Values.tilesRasterIngress }}'
  trafficTileServerUrl: '' # необходим отдельный прокси до растровых пробок
  {{- $traffic := ternary (printf "%s://%s" $protocol .Values.trafficProxyMapIngress) "" (has (lower .Values.proxyMode) (list "map" "full")) }}
  trafficTimestampServerUrl: '{{ $traffic }}'
  trafficScoreServerUrl: '{{ $traffic }}'
  catalogApiServerUrl: '{{ $protocol }}://{{ .Values.catalogIngress }}'
  keyServerUrl: '{{ $protocol }}://{{ .Values.keysApiIngress }}/public/v1/keys/'
  catalogApiKey: '{{ .Values.key }}'
  key: '{{ .Values.key }}'

ingress:
  enabled: true
  className: {{ .Values.ingressClassName }}
  annotations:
  {{- if eq .Values.ingressController "nginx" }}
    {{- $annotations := pick .Values.ingressAnnotations.nginx "cors" -}}
    {{- $result := dict -}}
    {{- range $_, $value := $annotations }}
      {{- $result = merge $result $value -}}
    {{- end }}
    {{- $result | toYaml | nindent 4 }}
  {{- else if eq .Values.ingressController "traefik" }}
    {{- $annotations := pick .Values.ingressAnnotations.traefik "cors" -}}
    {{- $middlewares := join "," (sortAlpha (values $annotations)) -}}
    {{- dict "traefik.ingress.kubernetes.io/router.middlewares" $middlewares | toYaml | nindent 4 }}
  {{- else }}
    {}
  {{- end }}
  hosts:
  - host: {{ .Values.rasterJsApiIngress }}
    paths:
    - path: /
      pathType: Prefix
  {{- if .Values.ingressTls }}
  tls:
  - hosts:
    - {{ .Values.rasterJsApiIngress }}
    secretName: {{ .Values.tlsSecret }}
  {{- end }}
