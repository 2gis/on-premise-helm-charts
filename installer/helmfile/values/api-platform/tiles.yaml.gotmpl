# Общие дефолты релизных цепочек tiles (tiles-api / tiles-api-raster) из
# services/api-platform/tiles.yaml.gotmpl. Per-release overrides: tiles-multi.yaml.gotmpl /
# tiles-raster.yaml.gotmpl; per-env слоты: valuesPath values/api-platform/tiles/{multi,raster}/.
cassandra:
  consistencyLevelRead: LOCAL_QUORUM
  consistencyLevelWrite: LOCAL_QUORUM

proxy:
  access:
    url: http://{{ .Values.releasePrefix }}keys-service-api

importer:
  enabled: true
  workerNum: 2
  writerNum: 8
  clearSnapshots: true
  cleaner:
    enabled: true
    limit: 1
  resources:
    limits:
      cpu: 1000m
      memory: 512Mi
    requests:
      cpu: 50m
      memory: 128Mi

api:
  uiWhitelist: 0.0.0.0/0
  replicaCount: 3
  resources:
    limits:
      cpu: 250m
      memory: 256Mi
    requests:
      cpu: 50m
      memory: 64Mi

license:
  url: https://{{ .Values.releasePrefix }}license

logLevel: info  # Allowed options: info|warn|debug|error.
logFormat: json # Allowed options: text|json.
