{{/*
Available Ingress annotations
*/}}
{{- define "ingressConfig" -}}
nginx:
  cors:
    nginx.ingress.kubernetes.io/enable-cors: "true"
    nginx.ingress.kubernetes.io/cors-allow-origin: "*"
    nginx.ingress.kubernetes.io/cors-allow-credentials: "true"
    nginx.ingress.kubernetes.io/cors-allow-methods: "GET, PUT, POST, DELETE, PATCH, OPTIONS"
    nginx.ingress.kubernetes.io/cors-allow-headers: "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-share-token,X-Company-Id,x-source"
  proxy:
    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "120"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "120"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "120"
  corsGet:
    nginx.ingress.kubernetes.io/cors-allow-origin: "*"
    nginx.ingress.kubernetes.io/cors-allow-methods: "GET"
  vpn:
    nginx.ingress.kubernetes.io/whitelist-source-range: "10.0.0.0/8"
traefik:
  cors: "{{ .Environment.Name }}-cors-headers@kubernetescrd"
  proxy: "{{ .Environment.Name }}-buffering-limit@kubernetescrd"
  corsGet: "{{ .Environment.Name }}-s3-cors-headers@kubernetescrd"
  vpn: "{{ .Environment.Name }}-allow-vpn-office@kubernetescrd"
{{- end -}}

{{/*
Filling .Values.ingressAnnotations
*/}}
{{- $config := include "ingressConfig" . | fromYaml -}}
{{- $_ := set .Values "ingressAnnotations" $config -}}
