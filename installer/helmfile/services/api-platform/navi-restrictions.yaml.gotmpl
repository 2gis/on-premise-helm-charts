---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: navi-restrictions
    chart: {{ .Values.chartLocation }}/navi-restrictions
    namespace: {{ .Values.namespace  }}
    version: {{ .Values.versionPlatform }}
    timeout: {{ .Values.timeoutNaviRestrictions }}
    kubeContext: {{ .Values.kubeContext }}
    labels:
      group: api-platform
      service: restrictions
    values:
      - {{ .Values.basePath }}/values/dgctl.yaml.gotmpl
      - {{ .Values.basePath }}/values/api-platform/navi-restrictions.yaml.gotmpl
      - {{ .Values.valuesPath }}/values/api-platform/navi-restrictions/{{ .Environment.Name }}.yaml.gotmpl
    hooks:
    - events: ["postsync"]
      showlogs: true
      command: "bash"
      args:
        - "{{ .Values.basePath }}/../scripts/k8s-show-logs.sh"
        - "{{ .Values.kubeContext }}"
        - "{{ .Values.namespace }}"
        - "{{`{{ .Release.Name }}`}}"
        - '{{`{{ if .Event.Error }}failure{{ end }}`}}'
{{- $hooksPath := printf "%s/hooks/api-platform/navi-restrictions/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
