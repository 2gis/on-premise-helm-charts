---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: pgbackup
    chart: {{ .Values.chartLocation }}/pgbackup
    version: 0.0.15
    namespace: {{ .Values.namespace }}
    kubeContext: {{ .Values.kubeContext }}
    labels:
        service: pgbackup
        group: infra
    values:
      - {{ .Values.basePath }}/values/infra/pgbackup.yaml.gotmpl
      - {{ .Values.valuesPath }}/values/infra/pgbackup/{{ .Environment.Name }}.yaml.gotmpl
    hooks:
    - events: ["postsync"]
      showlogs: true
      command: "bash"
      args:
        - "{{ .Values.basePath }}/../scripts/k8s-show-logs.sh"
        - "{{ .Values.kubeContext }}"
        - "{{ .Values.namespace }}"
        - "{{`{{ .Release.Name }}`}}"
        - '{{`{{ if .Event.Error }}failure{{ end }}`}}'
{{- $hooksPath := printf "%s/hooks/infra/pgbackup/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
