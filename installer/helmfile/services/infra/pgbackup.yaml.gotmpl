---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: {{ .Values.releasePrefix }}pgbackup
    chart: {{ .Values.chartLocation }}/pgbackup
    version: 0.0.15
    namespace: {{ .Values.namespace }}
    kubeContext: {{ .Values.kubeContext }}
    labels:
      service: pgbackup
      group: infra
    values:
      - {{ .Values.basePath }}/values/infra/pgbackup.yaml.gotmpl
{{- $dep := printf "%s/values/infra/pgbackup/_common.yaml.gotmpl" .Values.valuesPath -}}
{{- if isFile $dep }}
      - {{ $dep }}
{{- end }}
{{- $vp1 := printf "%s/values/infra/pgbackup/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp1 }}
      - {{ $vp1 }}
{{- end }}
    set:
{{- $f := printf "%s/values/infra/pgbackup/_common.set.yaml.gotmpl" .Values.valuesPath -}}
{{- if isFile $f }}
{{- tpl (readFile $f) . | fromYaml | toYaml | nindent 6 }}
{{- end }}
{{- $f2 := printf "%s/values/infra/pgbackup/%s.set.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $f2 }}
{{- tpl (readFile $f2) . | fromYaml | toYaml | nindent 6 }}
{{- end }}
{{- $secretsPath := printf "%s/values/infra/pgbackup/%s.secrets.yaml" .Values.valuesPath .Environment.Name -}}
{{- if isFile $secretsPath }}
    secrets:
      - {{ $secretsPath }}
{{- end }}
    hooks:
    - events: ["postsync"]
      showlogs: true
      command: "bash"
      args:
        - "{{ .Values.basePath }}/../scripts/k8s-show-logs.sh"
        - "{{ .Values.kubeContext }}"
        - "{{ .Values.namespace }}"
        - "{{`{{ .Release.Name }}`}}"
        - '{{`{{ if .Event.Error }}failure{{ end }}`}}'
{{- $hooksPath := printf "%s/hooks/infra/pgbackup/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
