---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: {{ .Values.releasePrefix }}cassandra
    chart: {{ .Values.chartLocationBitnami }}/cassandra
    version: 11.4.2
    namespace: {{ .Values.namespace }}
    kubeContext: {{ .Values.kubeContext }}
    createNamespace: false
    atomic: false
    wait: true
    waitForJobs: true
    timeout: 600
    labels:
      group: infra
      service: cassandra
    values:
      - {{ .Values.basePath }}/values/infra/cassandra.yaml.gotmpl
{{- $dep := printf "%s/values/infra/cassandra/_common.yaml.gotmpl" .Values.valuesPath -}}
{{- if isFile $dep }}
      - {{ $dep }}
{{- end }}
{{- $vp1 := printf "%s/values/infra/cassandra/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp1 }}
      - {{ $vp1 }}
{{- end }}
{{- $secretsPath := printf "%s/values/infra/cassandra/%s.secrets.yaml" .Values.valuesPath .Environment.Name -}}
{{- if isFile $secretsPath }}
    secrets:
      - {{ $secretsPath }}
{{- end }}
    hooks:
{{- $hooksPath := printf "%s/hooks/infra/cassandra/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
