---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: minio
    chart: {{ .Values.chartLocationBitnami }}/minio
    version: 17.0.21
    namespace: {{ .Values.namespace  }}
    kubeContext: {{ .Values.kubeContext }}
    atomic: true
    wait: true
    waitForJobs: true
    timeout: 600
    labels:
      group: infra
      service: minio
    values:
      - {{ .Values.basePath }}/values/ingressAnnotations.yaml.gotmpl
{{- $vp1 := printf "%s/values/ingressAnnotations/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp1 }}
      - {{ $vp1 }}
{{- end }}
      - {{ .Values.basePath }}/values/infra/minio.yaml.gotmpl
{{- $vp2 := printf "%s/values/infra/minio/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp2 }}
      - {{ $vp2 }}
{{- end }}
{{- $secretsPath := printf "%s/values/infra/minio/%s.secrets.yaml" .Values.valuesPath .Environment.Name -}}
{{- if isFile $secretsPath }}
    secrets:
      - {{ $secretsPath }}
{{- end }}
    hooks:
{{- $hooksPath := printf "%s/hooks/infra/minio/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
