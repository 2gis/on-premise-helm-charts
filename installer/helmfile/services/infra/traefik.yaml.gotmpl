---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: {{ .Values.releasePrefix }}traefik
    chart: oci://ghcr.io/traefik/helm/traefik
    version: 39.0.0
    namespace: {{ .Values.namespace }}
    kubeContext: {{ .Values.kubeContext }}
    timeout: 600
    labels:
      group: infra
      service: traefik
    values:
      - {{ .Values.basePath }}/values/infra/traefik.yaml.gotmpl
{{- $dep := printf "%s/values/infra/traefik/_common.yaml.gotmpl" .Values.valuesPath -}}
{{- if isFile $dep }}
      - {{ $dep }}
{{- end }}
{{- $vp1 := printf "%s/values/infra/traefik/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp1 }}
      - {{ $vp1 }}
{{- end }}
{{- $secretsPath := printf "%s/values/infra/traefik/%s.secrets.yaml" .Values.valuesPath .Environment.Name -}}
{{- if isFile $secretsPath }}
    secrets:
      - {{ $secretsPath }}
{{- end }}
    hooks:
    - events: ["postsync"]
      showlogs: true
      command: "bash"
      args:
        - "{{ .Values.basePath }}/../scripts/k8s-show-logs.sh"
        - "{{ .Values.kubeContext }}"
        - "{{ .Values.namespace }}"
        - "{{`{{ .Release.Name }}`}}"
        - '{{`{{ if .Event.Error }}failure{{ end }}`}}'
{{- $hooksPath := printf "%s/hooks/infra/traefik/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
