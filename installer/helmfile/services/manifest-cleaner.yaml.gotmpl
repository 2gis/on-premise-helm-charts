---
bases:
- {{ env "HELMFILE_BASE" | default (printf "%s/installer/helmfile" (env "PWD")) }}/common.yaml.gotmpl

---
releases:
  - name: {{ .Values.releasePrefix }}manifest-cleaner
    chart: {{ .Values.chartLocation }}/manifest-cleaner
    version: 0.2.0
    namespace: {{ .Values.namespace }}
    kubeContext: {{ .Values.kubeContext }}
    labels:
      group: monitoring
      service: manifest-cleaner
    values:
      - {{ .Values.basePath }}/values/manifest-cleaner.yaml.gotmpl
{{- $dep := printf "%s/values/manifest-cleaner/_common.yaml.gotmpl" .Values.valuesPath -}}
{{- if isFile $dep }}
      - {{ $dep }}
{{- end }}
{{- $vp1 := printf "%s/values/manifest-cleaner/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $vp1 }}
      - {{ $vp1 }}
{{- end }}
{{- $secretsPath := printf "%s/values/manifest-cleaner/%s.secrets.yaml" .Values.valuesPath .Environment.Name -}}
{{- if isFile $secretsPath }}
    secrets:
      - {{ $secretsPath }}
{{- end }}
    hooks:
    - events: ["postsync"]
      showlogs: true
      command: "bash"
      args:
        - "{{ .Values.basePath }}/../scripts/k8s-show-logs.sh"
        - "{{ .Values.kubeContext }}"
        - "{{ .Values.namespace }}"
        - "{{`{{ .Release.Name }}`}}"
        - '{{`{{ if .Event.Error }}failure{{ end }}`}}'
{{- $hooksPath := printf "%s/hooks/manifest-cleaner/%s.yaml.gotmpl" .Values.valuesPath .Environment.Name -}}
{{- if isFile $hooksPath }}
{{- readFile $hooksPath | fromYaml | toYaml | nindent 4 }}
{{- end }}
