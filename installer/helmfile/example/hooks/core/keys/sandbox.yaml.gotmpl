- events: ["postsync"]
  showlogs: true
  command: "bash"
  args:
    - -c
    - |
      export OP_NAMESPACE={{ .Values.namespace }}
      export OP_DOMAIN={{ .Values.domain }}
      export OP_ENV_FILE={{ .Values.valuesPath }}/environments/sandbox.yaml.gotmpl
      export OP_SECRETS_FILE={{ .Values.valuesPath }}/environments/sandbox.secrets.yaml
      {{ .Values.basePath }}/../scripts/create_sandbox_key.sh
