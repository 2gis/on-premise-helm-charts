# Keycloak override for the `sandbox` (kind) environment.
# Realms/services configure via Keycloak admin console after deploy (см. installer/README.md).
replicaCount: 1

tls:
  enabled: false

production: false
httpEnabled: true

resources:
  requests:
    cpu: 100m
    memory: 512Mi
  limits:
    cpu: 2
    memory: 2Gi
