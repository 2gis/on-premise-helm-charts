# Keys override for the `sandbox` (kind) environment - in-cluster PostgreSQL, Kafka, Redis.
# OIDC settings are inherited from the default values (mandatory OIDC via platform-id).
api:
  replicas: 1
  resources:
    requests:
      cpu: 10m
      memory: 20Mi
    limits:
      cpu: 100m
      memory: 128Mi

serviceApi:
  resources:
    requests:
      cpu: 10m
      memory: 56Mi
    limits:
      cpu: 1
      memory: 256Mi

tasker:
  resources:
    requests:
      cpu: 10m
      memory: 48Mi
    limits:
      cpu: 100m
      memory: 64Mi

counter:
  resources:
    requests:
      cpu: 10m
      memory: 20Mi
    limits:
      cpu: 1
      memory: 512Mi
