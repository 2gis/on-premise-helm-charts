s3:
  host: http://s3.sandbox
  bucket: sandbox-navi-am
  accessKey: {{ .Values.dgctlStorage.accessKey }}
  secretKey: {{ .Values.dgctlStorage.secretKey }}
  enabled: true

stat:
  enabled: true
  url: 'http://stat-receiver-api/bss/3'

resources:
  requests:
    cpu: 50m
    memory: 256Mi
  limits:
    cpu: 1
    memory: 1Gi
