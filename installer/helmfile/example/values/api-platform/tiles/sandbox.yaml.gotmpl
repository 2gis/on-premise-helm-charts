cassandra:
  environment: 'sandbox'
  hosts:
    - 'cassandra'
  replicaFactor: 1
  credentials:
    user: cassandra
    jmxUser: cassandra

proxy:
  access:
    enabled: true
    syncPeriod: 2m

importer:
  enabled: true
  workerNum: 1
  writerNum: 1

api:
  replicaCount: 1
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: 2
      memory: 2Gi
