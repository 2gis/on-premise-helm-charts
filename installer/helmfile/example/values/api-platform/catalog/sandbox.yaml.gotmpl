# Catalog API override for the `sandbox` (kind) environment - in-cluster PostgreSQL.
api:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 500Mi
    limits:
      cpu: 4
      memory: 4000Mi

importer:
  cleaner:
    enabled: true
    versionLimit: 3
  emptyDir:
    enabled: true
    medium: ''
    sizeLimit: 2Gi
