search:
  # Бэкенд поиска. По умолчанию search-api:
  url: http://search-api
  # Альтернатива - Search API v8 (деплой опционален, см. deploy/<env>.yaml.gotmpl).
  # При её использовании укажите:
  # url: http://search-api-v8-ingress-router:9092

# api:
  # resources: see chart defaults
  # resources:
  #   limits:
  #     cpu: 6
  #     memory: 8000Mi
  #   requests:
  #     cpu: 500m
  #     memory: 4000Mi
  # replicas: see chart defaults
  # replicas: 1

importer:
  cleaner:
    enabled: true
    versionLimit: 3
  emptyDir:
    enabled: true
    medium: ''
    sizeLimit: 10Gi
