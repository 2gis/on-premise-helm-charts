# Styles override for the `sandbox` (kind) environment - in-cluster PostgreSQL and MinIO.
s3:
  host: minio:9000
  secure: false
  publicDomain: s3.{{ .Values.domain }}
  publicSecure: false

stylesImport:
  startOnDeploy: true

api:
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 1
      memory: 1024Mi
